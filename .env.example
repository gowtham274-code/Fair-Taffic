# Copy to .env and edit. Never commit .env.
FAIRTRAFFIC_STORAGE=/data/storage          # experiment results, checkpoints, SQLite registry
FAIRTRAFFIC_API_KEY=change-me-long-random  # required to start/stop jobs through the API
FAIRTRAFFIC_ALLOW_MOCK=0                   # 1 lets the API run the mock test double (not SUMO)
FAIRTRAFFIC_DEV_OPEN=0                     # 1 = allow job control without a key (local development ONLY)
FAIRTRAFFIC_API_URL=http://api:8000        # used by the dashboard
SUMO_HOME=                                 # set if SUMO is installed outside PATH
